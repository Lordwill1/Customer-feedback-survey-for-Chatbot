<!DOCTYPE html>
<html lang="en">
  <head>
    <script src="/sdk/app-page-sdk.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      body {
        background-color: #f8fafc;
        font-family: "Source Sans Pro", "Trebuchet MS", Helvetica, sans-serif;
      }
      #logo {
        height: 10vh;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 10px;
      }
      .feedback-container {
        background-color: white;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 30px;
        max-width: 500px;
        margin: 20px auto;
        text-align: center;
        transition: all 0.3s ease;
        position: relative; /* Added for close button positioning */
      }
      /* Added close button style */
      .close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: none;
        border: none;
        font-size: 1.5rem;
        color: #718096;
        cursor: pointer;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
        z-index: 100;
      }
      
      .close-btn:hover {
        background-color: rgba(113, 128, 150, 0.1);
        color: #2d3748;
        transform: rotate(90deg);
      }
      .submit-btn {
        background: linear-gradient(to right, rgb(4, 122, 71), rgb(6, 144, 85));
        color: white;
        padding: 16px 30px;
        font-size: 18px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: bold;
        margin-top: 25px;
        transition: all 0.3s;
        width: 100%;
        box-shadow: 0 4px 6px rgba(4, 122, 71, 0.2);
      }
      .submit-btn:hover {
        background: linear-gradient(to right, rgb(6, 144, 85), rgb(4, 122, 71));
        box-shadow: 0 6px 8px rgba(4, 122, 71, 0.3);
        transform: translateY(-2px);
      }
      .submit-btn:disabled {
        background: #cbd5e0;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }
      .thank-you {
        display: none;
        color: rgb(4, 122, 71);
        font-weight: bold;
        margin-top: 20px;
        font-size: 1.3rem;
        padding: 15px;
        background-color: rgba(4, 122, 71, 0.1);
        border-radius: 10px;
      }
      .comment-box {
        width: 100%;
        min-height: 100px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px;
        margin-top: 20px;
        font-family: inherit;
        resize: vertical;
        display: block;
        transition: border-color 0.3s;
        font-size: 16px;
      }
      .comment-box:focus {
        outline: none;
        border-color: rgb(4, 122, 71);
        box-shadow: 0 0 0 3px rgba(4, 122, 71, 0.1);
      }
      h2 {
        color: #2d3748;
        font-weight: 700;
        margin-bottom: 10px;
        font-size: 1.8rem;
      }
      p {
        color: #718096;
        line-height: 1.6;
        font-size: 1.1rem;
      }
      .optional {
        font-size: 0.9rem;
        color: #a0aec0;
        margin-top: 5px;
        text-align: left;
      }
      .countdown {
        display: inline-block;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background-color: rgba(4, 122, 71, 0.2);
        text-align: center;
        line-height: 24px;
        margin-left: 5px;
        font-size: 0.9rem;
      }
      
      /* Styles for emotions */
      .emotions-container {
        margin: 30px 0;
      }
      .emotions {
        display: flex;
        justify-content: space-around;
        margin: 20px 0;
      }
      .emotion {
        font-size: 2.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        filter: grayscale(100%);
        opacity: 0.7;
        transform: scale(1);
      }
      .emotion:hover {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.2);
      }
      .emotion.selected {
        filter: grayscale(0%);
        opacity: 1;
        transform: scale(1.3);
      }
      .emotion-label {
        font-size: 0.8rem;
        margin-top: 5px;
        color: #718096;
        text-transform: capitalize;
      }
      .emotion-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      
      @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
      }
      .pulse {
        animation: pulse 1s infinite;
      }
      
      /* Enhanced Thank You Section */
      .success-animation {
        display: flex;
        justify-content: center;
        margin-bottom: 25px;
      }
      
      .success-checkmark {
        width: 80px;
        height: 80px;
        margin: 0 auto;
      }
      
      .check-icon {
        width: 80px;
        height: 80px;
        position: relative;
        border-radius: 50%;
        box-sizing: content-box;
        border: 4px solid rgba(4, 122, 71, 0.2);
      }
      
      .check-icon::before {
        top: 3px;
        left: -2px;
        width: 30px;
        transform-origin: 100% 50%;
        border-radius: 100px 0 0 100px;
      }
      
      .check-icon::after {
        top: 0;
        left: 30px;
        width: 60px;
        transform-origin: 0 50%;
        border-radius: 0 100px 100px 0;
        animation: rotate-circle 4.25s ease-in;
      }
      
      .check-icon::before, .check-icon::after {
        content: '';
        height: 100px;
        position: absolute;
        background: #ffffff;
        transform: rotate(-45deg);
      }
      
      .icon-line {
        height: 5px;
        background-color: rgb(4, 122, 71);
        display: block;
        border-radius: 2px;
        position: absolute;
        z-index: 10;
      }
      
      .icon-line.line-tip {
        top: 46px;
        left: 14px;
        width: 25px;
        transform: rotate(45deg);
        animation: icon-line-tip 0.75s;
      }
      
      .icon-line.line-long {
        top: 38px;
        right: 8px;
        width: 47px;
        transform: rotate(-45deg);
        animation: icon-line-long 0.75s;
      }
      
      .icon-circle {
        top: -4px;
        left: -4px;
        z-index: 10;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        position: absolute;
        box-sizing: content-box;
        border: 4px solid rgba(4, 122, 71, 0.5);
      }
      
      .icon-fix {
        top: 8px;
        width: 5px;
        left: 26px;
        z-index: 1;
        height: 85px;
        position: absolute;
        transform: rotate(-45deg);
        background-color: #ffffff;
      }
      
      @keyframes rotate-circle {
        0% {
          transform: rotate(-45deg);
        }
        5% {
          transform: rotate(-45deg);
        }
        12% {
          transform: rotate(-405deg);
        }
        100% {
          transform: rotate(-405deg);
        }
      }
      
      @keyframes icon-line-tip {
        0% {
          width: 0;
          left: 1px;
          top: 19px;
        }
        54% {
          width: 0;
          left: 1px;
          top: 19px;
        }
        70% {
          width: 50px;
          left: -8px;
          top: 37px;
        }
        84% {
          width: 17px;
          left: 21px;
          top: 48px;
        }
        100% {
          width: 25px;
          left: 14px;
          top: 45px;
        }
      }
      
      @keyframes icon-line-long {
        0% {
          width: 0;
          right: 46px;
          top: 54px;
        }
        65% {
          width: 0;
          right: 46px;
          top: 54px;
        }
        84% {
          width: 55px;
          right: 0px;
          top: 35px;
        }
        100% {
          width: 47px;
          right: 8px;
          top: 38px;
        }
      }
      
      .thank-you-container {
        display: none;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border-radius: 20px;
        padding: 40px 30px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(4, 122, 71, 0.15);
        border: 1px solid rgba(4, 122, 71, 0.1);
        position: relative;
        overflow: hidden;
      }
      
      .thank-you-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
        background: linear-gradient(to right, rgb(4, 122, 71), rgb(6, 144, 85), rgb(74, 222, 128));
      }
      
      .thank-you-title {
        color: rgb(4, 122, 71);
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 15px;
      }
      
      .thank-you-message {
        color: #64748b;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 25px;
      }
      
      .countdown-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: rgba(4, 122, 71, 0.05);
        padding: 12px 20px;
        border-radius: 50px;
        margin-top: 20px;
      }
      
      .countdown-text {
        color: #475569;
        font-size: 0.95rem;
      }
      
      .enhanced-countdown {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgb(4, 122, 71), rgb(6, 144, 85));
        color: white;
        font-weight: bold;
        font-size: 1rem;
        box-shadow: 0 4px 8px rgba(4, 122, 71, 0.3);
        animation: countdown-pulse 1.5s infinite;
      }
      
      @keyframes countdown-pulse {
        0% {
          transform: scale(1);
          box-shadow: 0 4px 8px rgba(4, 122, 71, 0.3);
        }
        50% {
          transform: scale(1.1);
          box-shadow: 0 6px 12px rgba(4, 122, 71, 0.4);
        }
        100% {
          transform: scale(1);
          box-shadow: 0 4px 8px rgba(4, 122, 71, 0.3);
        }
      }
      
      .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: #f0f;
        opacity: 0.7;
      }
      
      @keyframes confetti-fall {
        0% {
          transform: translateY(-100px) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(500px) rotate(360deg);
          opacity: 0;
        }
      }
      
      .fade-in {
        animation: fadeIn 0.8s ease forwards;
      }
      
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>

  <body>

    <div class="feedback-container">
      <!-- Added close button -->
      <button class="close-btn" id="close-survey" title="Close survey">
        <i class="fas fa-times"></i>
      </button>
      
      <h2>Rate your experience</h2>
      <p>How do you feel about the help you got today?</p>
      
      <div class="emotions-container">
        <div class="emotions">
          <div class="emotion-wrapper">
            <div class="emotion" data-emotion="1 star">😠</div>
            <div class="emotion-label">Frustrated</div>
          </div>
          <div class="emotion-wrapper">
            <div class="emotion" data-emotion="2 stars">😔</div>
            <div class="emotion-label">Disappointed</div>
          </div>
          <div class="emotion-wrapper">
            <div class="emotion" data-emotion="3 stars">😐</div>
            <div class="emotion-label">Neutral</div>
          </div>
          <div class="emotion-wrapper">
            <div class="emotion" data-emotion="4 stars">😊</div>
            <div class="emotion-label">Satisfied</div>
          </div>
          <div class="emotion-wrapper">
            <div class="emotion" data-emotion="5 stars">😍</div>
            <div class="emotion-label">Delighted</div>
          </div>
        </div>
      </div>
      
      <div>
        <textarea class="comment-box" placeholder="Tell us more about your experience (optional)"></textarea>
        <p class="optional">Your feedback help us improve our service</p>
      </div>
      
      <button class="submit-btn" id="submit-feedback" disabled>
        <i class="fas fa-paper-plane"></i> SEND YOUR FEEDBACK
      </button>
      
      <div class="thank-you">
        <i class="fas fa-check-circle"></i> 
        <span id="thank-you-message">Thank you for your feedback!<span class="countdown">3</span></span>
      </div>
      
      <!-- Enhanced Thank You Container -->
      <div class="thank-you-container fade-in" id="enhanced-thank-you">
        <div class="success-animation">
          <div class="success-checkmark">
            <div class="check-icon">
              <span class="icon-line line-tip"></span>
              <span class="icon-line line-long"></span>
              <div class="icon-circle"></div>
              <div class="icon-fix"></div>
            </div>
          </div>
        </div>
        
        <h3 class="thank-you-title" id="thank-you-title">Thank You!</h3>
        <p class="thank-you-message" id="thank-you-message-enhanced">
          We appreciate you taking the time to share your feedback with us.
        </p>
        
        <div class="countdown-container">
          <span class="countdown-text">Closing in</span>
          <div class="enhanced-countdown" id="enhanced-countdown">5</div>
          <span class="countdown-text">seconds</span>
        </div>
      </div>
    </div>

  <script>
  let selectedEmotion = null;
  let countdownInterval;

  // Emotion selection
  document.querySelectorAll('.emotion').forEach(emotion => {
    emotion.addEventListener('click', function() {
      selectedEmotion = this.getAttribute('data-emotion');

      // Update emotion visual state
      document.querySelectorAll('.emotion').forEach(e => {
        e.classList.remove('selected');
      });
      this.classList.add('selected');

      // Enable submit button
      document.getElementById('submit-feedback').disabled = false;
    });
  });

  // Handle close button click - Send "No survey" event to bot
  document.getElementById('close-survey').addEventListener('click', function() {
    // Send event to Cognigy bot with "No survey" identifier
    SDK.submit({
      action: 'close_survey',
      message: 'No survey',
      feedbackType: 'survey_closed',
      timestamp: new Date().toISOString()  // Added timestamp for tracking
    });
    
    // Close the xApp
    SDK.close();
  });

  // Added: Escape key support - allows users to close survey with ESC key
  document.addEventListener('keydown', function(event) {
    // Check if Escape key is pressed (key code 27)
    if (event.key === 'Escape' || event.keyCode === 27) {
      // Send the same "No survey" event as the close button
      SDK.submit({
        action: 'close_survey',
        message: 'No survey',
        feedbackType: 'survey_closed',
        timestamp: new Date().toISOString(),  // Timestamp for tracking
        closedBy: 'escape_key'  // Additional info: how it was closed
      });
      
      // Close the xApp
      SDK.close();
    }
  });

  // Create confetti effect
  function createConfetti() {
    const container = document.querySelector('.thank-you-container');
    const colors = ['#047a47', '#069055', '#4ade80', '#86efac', '#bbf7d0'];
    
    for (let i = 0; i < 30; i++) {
      const confetti = document.createElement('div');
      confetti.className = 'confetti';
      confetti.style.left = Math.random() * 100 + '%';
      confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
      confetti.style.animation = `confetti-fall ${Math.random() * 3 + 2}s linear forwards`;
      container.appendChild(confetti);
    }
  }

  // Handle feedback submission
  document.getElementById('submit-feedback').addEventListener('click', function() {
    const comment = document.querySelector('.comment-box').value;
    
    // Hide the close button when submission starts
    document.getElementById('close-survey').style.display = 'none';
    
    // Hide original form elements
    document.querySelector('h2').style.display = 'none';
    document.querySelector('p').style.display = 'none';
    document.querySelector('.emotions-container').style.display = 'none';
    document.querySelector('.comment-box').parentElement.style.display = 'none';
    document.querySelector('.submit-btn').style.display = 'none';
    
    // Show enhanced thank you container
    const thankYouContainer = document.getElementById('enhanced-thank-you');
    thankYouContainer.style.display = 'block';
    
    // Customize message based on rating
    const thankYouTitle = document.getElementById('thank-you-title');
    const thankYouMessage = document.getElementById('thank-you-message-enhanced');
    
    // Apply specific messages based on rating
    if (selectedEmotion === '1 star' || selectedEmotion === '2 stars') {
      thankYouTitle.innerHTML = "Thank You!";
      thankYouMessage.innerHTML = "We're sorry your experience didn't go as expected, we will use your feedback to make improvements. <br> Thank you for sharing!";
    } else {
      // For 3-5 stars
      thankYouTitle.innerHTML = "Thank You!";
      thankYouMessage.innerHTML = "We are delighted to hear about your positive experience.<br>It will help us do even better next time!";
      
      // Create confetti for positive ratings (3-5 stars)
      createConfetti();
    }
    
    // Countdown logic
    let countdown = 5;
    const countdownElement = document.getElementById('enhanced-countdown');

    countdownInterval = setInterval(() => {
      countdown--;
      countdownElement.textContent = countdown;

      if (countdown <= 0) {
        clearInterval(countdownInterval);

        SDK.submit({
          rating: selectedEmotion,
          comment: comment,
          feedbackType: 'emotional_response',
          timestamp: new Date().toISOString()  // Added timestamp for tracking
        });

        SDK.close();
      }
    }, 1000);
  });
</script>


  </body>
</html>
